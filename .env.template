# Copy to .env for LOCAL testing. In GitHub, add each as a repo secret instead.
# ---------------------------------------------------------------------------

# Telegram summary bot (talk to @BotFather to create; get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 (console.cloud.google.com -> enable "YouTube Data API v3"
# -> OAuth client of type "Desktop app"). Run scripts/youtube_auth.py for the token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Tumblr (no app review). Register an app: https://www.tumblr.com/oauth/apps
# Get OAuth tokens via https://api.tumblr.com/console (it shows all 4 values). ----
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_OAUTH_TOKEN=
TUMBLR_OAUTH_SECRET=
TUMBLR_BLOG=                 # e.g. astrotobby.tumblr.com

# ---- X / Twitter (free tier; ~500 writes/month). Create app + tokens at
# https://developer.x.com/ — you need a project with Read+Write access. ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- Reddit (OPTIONAL, off by default — see HONEST-LIMITS.md). "script" app at
# https://www.reddit.com/prefs/apps ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Instagram / Facebook / LinkedIn / Pinterest: deferred (need their own dev apps +
# review). Rendered Reels are saved as Action artifacts for manual upload meanwhile.

# Optional: royalty-free background music
PIXABAY_API_KEY=

# Your live site, used to build the "read the full post" CTA link
SITE_BASE_URL=https://astrotobby.site
