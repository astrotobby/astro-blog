# Copy to .env for LOCAL testing. In GitHub, add each as a repo secret instead.
# ---------------------------------------------------------------------------

# Telegram summary bot (talk to @BotFather to create; get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 (console.cloud.google.com -> enable "YouTube Data API v3"
# -> OAuth client of type "Desktop app"). Run scripts/youtube_auth.py for the token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Tumblr (no app review). Register an app: https://www.tumblr.com/oauth/apps
# Get OAuth tokens via https://api.tumblr.com/console (it shows all 4 values). ----
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_OAUTH_TOKEN=
TUMBLR_OAUTH_SECRET=
TUMBLR_BLOG=                 # e.g. astrotobby.tumblr.com

# ---- X / Twitter (free tier; ~500 writes/month). Create app + tokens at
# https://developer.x.com/ — you need a project with Read+Write access. ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- Facebook Page (Graph API). Create app at developers.facebook.com, get a
# long-lived Page access token. ----
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ---- Instagram (via Facebook Page token — same app, same token). ----
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ---- Threads (same Facebook app, separate token). ----
THREADS_ACCESS_TOKEN=
THREADS_ACCOUNT_ID=

# ---- TikTok (developers.tiktok.com -> create app with "Content Posting" scope). ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---- Pinterest (developers.pinterest.com -> create app). ----
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# ---- Reddit (OPTIONAL, off by default — see HONEST-LIMITS.md). "script" app at
# https://www.reddit.com/prefs/apps ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ---- Openverse API key (get free at api.openverse.org — improves rate limits
# from 5/day to 5000/day). Optional but strongly recommended. ----
OPENVERSE_TOKEN=

# ---- LinkedIn is deferred — requires its own developer app + review. ----

# Optional: Hugging Face token for AI image generation fallback
HF_TOKEN=

# Optional: royalty-free background music
PIXABAY_API_KEY=

# GitHub token for hosting videos as Release assets (creates public URLs)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Your live site, used to build the "read the full post" CTA link
SITE_BASE_URL=https://astrotobby.site
