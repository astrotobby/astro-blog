# Anthropic API Key for chatbot
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Idlen publisher key for sponsored messages in the chat widget (/api/chat-ad)
# Create one at https://adsmanager.idlen.io/publisher/api-keys
# Local: add to .dev.vars. Production: wrangler secret put IDLEN_API_KEY
IDLEN_API_KEY=idl_pk_your_key_here
