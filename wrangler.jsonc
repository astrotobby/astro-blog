{
"compatibility_date": "2024-04-03",
"compatibility_flags": ["global_fetch_strictly_public"],
"name": "astro-blog",

"assets": {
"directory": "./dist",
"binding": "ASSETS"
},
"observability": {
"enabled": true
},
"ai": {
"binding": "AI"
},
"vars": {
"ENVIRONMENT": "production"
},
"env": {
"production": {
"vars": {
"ENVIRONMENT": "production"
}
},
"development": {
"vars": {
"ENVIRONMENT": "development"
}
}
}
}
