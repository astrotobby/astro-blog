{
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "astro-blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SHOPIFY_STORE_DOMAIN": "astrotobby.myshopify.com",
    "SHOPIFY_STOREFRONT_API_TOKEN": "27429cf8e2f2e9e6a191721481de15a4"
  }
}
