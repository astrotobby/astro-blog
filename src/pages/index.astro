---
export const prerender = true;
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import AdBanner from '../components/AdBanner.astro';
import Newsletter from '../components/Newsletter.astro';

import { displayImage, svgFallback } from '../lib/postImage';

const orderKey = (p) => {
  const id = p.id || '';
  const ms = id.match(/-(\d{13})$/);
  if (ms) return Number(ms[1]);
  const d = id.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (d) return Date.parse(`${d[1]}-${d[2]}-${d[3]}T00:00:00Z`);
  return p.data.pubDate ? p.data.pubDate.valueOf() : 0;
};
const posts = (await getCollection('blog')).sort((a, b) => orderKey(b) - orderKey(a));

const featuredPost = posts[0];
const gridPosts = posts.slice(1, 9);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <section class="growth-hero" aria-labelledby="growth-hero-title">
      <div class="growth-hero-inner">
        <p class="growth-eyebrow">AI systems for ambitious operators</p>
        <h1 id="growth-hero-title">Turn AI into a growth system — not another tab.</h1>
        <p class="growth-lede">Astro Signal helps creators and small businesses find practical automation, AI-search visibility, and content opportunities that can compound into revenue.</p>
        <div class="growth-actions">
          <button class="growth-primary" type="button" id="open-growth-advisor">Get your AI growth diagnosis <span>→</span></button>
          <a class="growth-secondary" href="/portfolio">Explore implementation work</a>
        </div>
        <div class="growth-proof" aria-label="What the advisor helps with"><span>Automation</span><span>AEO / GEO</span><span>Content systems</span><span>Done-for-you builds</span></div>
      </div>
    </section>

    <!-- ═══ TUKO-STYLE: Inline Leaderboard Banner (Blends with layout) ═══ -->
    <div class="site-top-ad" aria-label="Advertisement">
      <span class="ad-label">Advertisement</span>
      <div class="ad-container">
        <AdBanner slot="top" minHeight="90px" margin="0 auto" />
      </div>
    </div>

    <main>
      <div class="rd-layout">
        <div class="rd-main">
          {featuredPost && (
            <a href={`/blog/${featuredPost.id}/`} class="feat" data-reveal>
              <div class="feat-media">
                <img
                  src={displayImage(featuredPost.data.title, featuredPost.data.image)}
                  data-fb={svgFallback(featuredPost.data.title)}
                  alt={featuredPost.data.title}
                  width="1200" height="627" loading="eager" fetchpriority="high" decoding="async"
                  onerror="this.onerror=null;this.src=this.dataset.fb;"
                />
                <span class="feat-badge">Featured</span>
              </div>
              <div class="feat-body">
                <span class="feat-date"><FormattedDate date={featuredPost.data.pubDate} /></span>
                <h2 class="feat-title">{featuredPost.data.title}</h2>
                <p class="feat-desc">{featuredPost.data.description}</p>
                <span class="feat-more">Read article →</span>
              </div>
            </a>
          )}

          <h2 class="rd-heading">Latest Articles</h2>
          <div class="post-grid">
            {gridPosts.map((post, i) => (
              <a href={`/blog/${post.id}/`} class="pcard" data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <div class="pcard-media">
                  <img
                    src={displayImage(post.data.title, post.data.image)}
                    data-fb={svgFallback(post.data.title)}
                    alt={post.data.title}
                    width="600" height="360" loading="lazy" decoding="async"
                    onerror="this.onerror=null;this.src=this.dataset.fb;"
                  />
                </div>
                <div class="pcard-body">
                  <span class="pcard-date"><FormattedDate date={post.data.pubDate} /></span>
                  <h3 class="pcard-title">{post.data.title}</h3>
                  <p class="pcard-desc">{post.data.description}</p>
                  <span class="pcard-more">Read more →</span>
                </div>
              </a>
            ))}
          </div>

          <div class="see-all">
            <a href="/blog" class="btn btn-primary">View all articles</a>
          </div>
        </div>

        <Sidebar limit={5} />
      </div>

      

      <Newsletter />
    </main>
    <Footer />

    <script is:inline>
      document.getElementById('open-growth-advisor')?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('astro:open-growth-advisor')));
    </script>

    <style>
      .growth-hero { background: linear-gradient(135deg, #073b3a 0%, #0b5960 52%, #146b7a 100%); color: #fff; margin: 0; }
      .growth-hero-inner { max-width: 1120px; margin: 0 auto; padding: clamp(3.5rem, 8vw, 6.5rem) 1.5rem clamp(3rem, 6vw, 5rem); }
      .growth-eyebrow { color: #8ef0d2; font-size: .78rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 1rem; }
      .growth-hero h1 { max-width: 760px; font-size: clamp(2.35rem, 6vw, 4.9rem); line-height: 1.02; letter-spacing: -.045em; margin: 0 0 1.25rem; color: #fff; }
      .growth-lede { max-width: 680px; color: rgba(255,255,255,.84); font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.6; margin: 0 0 1.8rem; }
      .growth-actions { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; }
      .growth-primary, .growth-secondary { border-radius: 10px; padding: .85rem 1.15rem; font-weight: 800; text-decoration: none; font-size: .95rem; }
      .growth-primary { border: 0; background: #8ef0d2; color: #063b39; cursor: pointer; }
      .growth-primary span { margin-left: .4rem; font-size: 1.2rem; }
      .growth-secondary { color: #fff; border: 1px solid rgba(255,255,255,.38); }
      .growth-proof { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 2.2rem; }
      .growth-proof span { border: 1px solid rgba(255,255,255,.24); border-radius: 999px; padding: .4rem .7rem; color: rgba(255,255,255,.8); font-size: .76rem; }
      /* ── Tuko-style: Inline Leaderboard ── */
      .site-top-ad {
        width: 100%;
        background: var(--bg-primary);
        border-bottom: 1px solid var(--border-light);
        padding: 0.75rem 1rem;
        text-align: center;
      }
      .site-top-ad .ad-label {
        display: block;
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
      }
      .site-top-ad .ad-container {
        max-width: 970px;
        margin: 0 auto;
        min-height: 90px;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* Featured card — image on top, text below (avoids clashing with title-in-image) */
      .feat {
        display: block; text-decoration: none; margin-bottom: 2.5rem;
        background: var(--bg-secondary); border: 1px solid var(--border-light);
        border-radius: var(--radius); overflow: hidden; box-shadow: var(--box-shadow);
        transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
      }
      .feat:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
      .feat-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
      .feat-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-slow) var(--ease-out); }
      .feat:hover .feat-media img { transform: scale(1.04); }
      .feat-badge {
        position: absolute; top: 1rem; left: 1rem; z-index: 2;
        padding: 0.35rem 0.85rem; border-radius: 999px;
        font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
        color: #fff; background: var(--accent);
      }
      .feat-body { padding: 1.5rem 1.75rem 1.75rem; }
      .feat-date { display: block; color: var(--accent); font-size: 0.82rem; font-weight: 600; margin-bottom: 0.5rem; }
      .feat-title { font-size: clamp(1.5rem, 3vw, 2.05rem); color: var(--text-heading); margin: 0 0 0.6rem; line-height: 1.18; }
      .feat-desc {
        color: var(--text-body); margin: 0 0 1rem; font-size: 1rem; line-height: 1.6;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .feat-more { font-weight: 700; color: var(--accent); font-size: 0.95rem; }

      /* Article grid */
      .post-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
      .pcard {
        display: flex; flex-direction: column; text-decoration: none;
        background: var(--bg-secondary); border: 1px solid var(--border-light);
        border-radius: var(--radius); overflow: hidden;
        transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
      }
      .pcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
      .pcard-media { aspect-ratio: 16 / 9; overflow: hidden; }
      .pcard-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-slow) var(--ease-out); }
      .pcard:hover .pcard-media img { transform: scale(1.06); }
      .pcard-body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; flex: 1; }
      .pcard-date { font-size: 0.78rem; color: var(--accent); font-weight: 600; margin-bottom: 0.45rem; }
      .pcard-title { font-size: 1.15rem; margin: 0 0 0.5rem; color: var(--text-heading); line-height: 1.25; }
      .pcard-desc {
        font-size: 0.92rem; color: var(--text-body); line-height: 1.55; margin: 0 0 0.9rem;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
      }
      .pcard-more { margin-top: auto; font-weight: 600; color: var(--accent); font-size: 0.9rem; }

      .see-all { margin: 2.5rem 0 0.5rem; text-align: center; }

      @media (max-width: 620px) {
        .post-grid { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
