---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import AdBanner from '../../components/AdBanner.astro';
import AdsterraNativeBanner from '../../components/AdsterraNativeBanner.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { displayImage, svgFallback } from '../../lib/postImage';

const orderKey = (p) => {
  const id = p.id || '';
  const ms = id.match(/-(\d{13})$/);
  if (ms) return Number(ms[1]);
  const d = id.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (d) return Date.parse(`${d[1]}-${d[2]}-${d[3]}T00:00:00Z`);
  return p.data.pubDate ? p.data.pubDate.valueOf() : 0;
};
const posts = (await getCollection('blog')).sort((a, b) => orderKey(b) - orderKey(a));
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      .page-header {
        position: relative;
        max-width: var(--maxw);
        margin: 3.5rem auto 0;
        padding: 4.5rem 2rem;
        text-align: center;
        border-radius: var(--radius-xl);
        overflow: hidden;
      }
      .page-header .badge { margin-bottom: 1.25rem; }
      .page-title {
        font-size: clamp(2.4rem, 5vw, 3.5rem);
        font-weight: 800;
        margin: 0 0 1rem;
        letter-spacing: -0.03em;
      }
      .page-subtitle { color: var(--text-body); font-size: 1.15rem; max-width: 56ch; margin: 0 auto; }

      .posts-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }
      .ad-grid-span {
        grid-column: 1 / -1;
      }
      .post-card { text-decoration: none; display: flex; flex-direction: column; overflow: hidden; }
      .post-media { position: relative; height: 210px; overflow: hidden; }
      .post-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-slow) var(--ease-out); }
      .post-card:hover .post-media img { transform: scale(1.06); }
      .card-body { padding: 1.6rem; display: flex; flex-direction: column; flex: 1; }
      .card-date { font-size: 0.82rem; color: var(--accent); font-weight: 600; margin-bottom: 0.6rem; }
      .card-title { font-size: 1.25rem; color: var(--text-heading); margin: 0 0 0.7rem; line-height: 1.3; font-weight: 700; }
      .card-desc {
        font-size: 0.96rem; color: var(--text-body); line-height: 1.6; margin: 0;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
      }

      @media (max-width: 900px) {
        .posts-grid { grid-template-columns: repeat(2, 1fr); }
        .page-header { margin-top: 2rem; padding: 3.5rem 1.5rem; }
      }
      @media (max-width: 600px) {
        .posts-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <AdBanner slot="top" minHeight="90px" margin="0 auto 24px" />

      <section class="page-header glass" data-reveal>
        <span class="badge"><span class="dot"></span> The Archive</span>
        <h1 class="page-title">Every <span class="gradient-text">deep dive</span>, in one place</h1>
        <p class="page-subtitle">A growing collection of breakdowns on the future of technology and artificial intelligence.</p>
      </section>

      <section class="section" style="margin: 4rem auto 2rem;">
        <div class="posts-grid">
          {posts.map((post, i) => (
            <>
              {i === 3 && (
                <div class="ad-grid-span">
                  <AdBanner slot="blog-grid-mid" minHeight="90px" margin="0 auto" />
                </div>
              )}
              {i === 6 && (
                <div class="ad-grid-span">
                  <AdsterraNativeBanner slot="blog-grid" />
                </div>
              )}
              <a href={`/blog/${post.id}/`} class="post-card card-glass" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
                <div class="post-media">
                  <img src={displayImage(post.data.title, post.data.image)} data-fb={svgFallback(post.data.title)} alt={post.data.title} loading="lazy" decoding="async" onerror="this.onerror=null;this.src=this.dataset.fb;" />
                </div>
                <div class="card-body">
                  <p class="card-date"><FormattedDate date={post.data.pubDate} /></p>
                  <h3 class="card-title">{post.data.title}</h3>
                  <p class="card-desc">{post.data.description}</p>
                </div>
              </a>
            </>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
