---
import Layout from '../layouts/Layout.astro';  // Adjust import if your layout name is different (e.g. BlogPost.astro)
---

<Layout
  title="Contact | Astro Tobby"
  description="Get in touch with Astro Tobby - AI Agents & Technology Insights"
>
  <main class="max-w-3xl mx-auto px-6 py-12">
    <article class="prose prose-lg">
      <h1>Contact Astro Tobby</h1>
      
      <p class="text-xl text-gray-600 dark:text-gray-400">
        Have a question about AI agents, multi-agent systems, or want to collaborate? 
        I'm always happy to connect.
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <!-- Email -->
        <div class="bg-white dark:bg-gray-900 p-8 rounded-2xl border border-gray-200 dark:border-gray-800">
          <div class="text-4xl mb-4">📧</div>
          <h3 class="text-xl font-semibold mb-2">Email Me</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            For business inquiries, guest posts, or detailed discussions.
          </p>
          <a 
            href="mailto:tobby@astrotobby.site" 
            class="inline-block bg-black text-white px-6 py-3 rounded-xl hover:bg-gray-800 transition-colors"
          >
            tobby@astrotobby.site
          </a>
        </div>

        <!-- Social -->
        <div class="bg-white dark:bg-gray-900 p-8 rounded-2xl border border-gray-200 dark:border-gray-800">
          <div class="text-4xl mb-4">🌐</div>
          <h3 class="text-xl font-semibold mb-2">Follow Me</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Latest AI insights and updates:
          </p>
          
          <div class="space-y-4">
            <a href="https://x.com/AstroboyTobby1" target="_blank" rel="noopener noreferrer" 
               class="flex items-center gap-4 text-lg hover:text-blue-600 transition-colors">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span>@AstroboyTobby1 on X</span>
            </a>

            <a href="https://www.instagram.com/astro_tobby/" target="_blank" rel="noopener noreferrer" 
               class="flex items-center gap-4 text-lg hover:text-pink-600 transition-colors">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <span>@astro_tobby on Instagram</span>
            </a>

            <a href="https://www.tiktok.com/@astrotobby" target="_blank" rel="noopener noreferrer" 
               class="flex items-center gap-4 text-lg hover:text-black transition-colors">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.9-.32-1.98-.23-2.81.36-.54.4-.89.98-1.03 1.64-.13.47-.12.95-.12 1.44.02 1.05.51 2.04 1.35 2.66.41.31.89.55 1.4.68 1.14.3 2.37-.12 3.12-1.05.3-.33.52-.73.63-1.16.1-.47.08-.96.08-1.44.02-4.14-.01-8.28.02-12.42z"/></svg>
              <span>@astrotobby on TikTok</span>
            </a>
          </div>
        </div>
      </div>

      <p class="mt-12 text-center text-sm text-gray-500">
        I typically respond within 48 hours.
      </p>
    </article>
  </main>
</Layout>