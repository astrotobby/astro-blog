---
export const prerender = true;
import Layout from '../layouts/BlogPost.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Astro Signal — AI agents, automation & AEO insights, by Astro Tobby."
  pubDate={new Date()}
>
  <p class="contact-lede">
    Have a question about AI agents, multi-agent systems, or want to collaborate?
    I'm always happy to connect.
  </p>

  <div class="contact-grid">
    <div class="contact-card card-glass">
      <span class="contact-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 5L2 7"></path></svg>
      </span>
      <h3>Email Me</h3>
      <p>For business inquiries, guest posts, or detailed discussions.</p>
      <a href="mailto:goodluck@astrotobby.site" class="btn btn-primary">goodluck@astrotobby.site</a>
    </div>

    <div class="contact-card card-glass">
      <span class="contact-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
      </span>
      <h3>Follow Me</h3>
      <p>Latest AI insights and updates:</p>
      <div class="social-list">
        <a href="https://x.com/AstroboyTobby1" target="_blank" rel="noopener noreferrer">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>@AstroboyTobby1</span>
        </a>
        <a href="https://www.instagram.com/astr_osignal" target="_blank" rel="noopener noreferrer">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span>@astr_osignal</span>
        </a>
        <a href="https://www.facebook.com/AstroteeSignal" target="_blank" rel="noopener noreferrer">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          <span>astrosignal</span>
        </a>
        <a href="https://www.youtube.com/@astrosignal" target="_blank" rel="noopener noreferrer">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          <span>astrosignal</span>
        </a>
      </div>
    </div>
  </div>

  <form id="contactForm" class="contact-form card-glass">
    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Send Message</button>
    <p class="form-note" id="formNote" hidden>Opening your email app… if nothing happens, email <a href="mailto:goodluck@astrotobby.site">goodluck@astrotobby.site</a> directly.</p>
  </form>

  <p class="contact-foot">I typically respond within 3 hours.</p>

  <script is:inline>
    (function () {
      var form = document.getElementById('contactForm');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = (document.getElementById('name').value || '').trim();
        var email = (document.getElementById('email').value || '').trim();
        var message = (document.getElementById('message').value || '').trim();
        var subject = 'Astro Signal contact — ' + (name || 'site visitor');
        var body = 'Name: ' + name + '\nEmail: ' + email + '\n\n' + message;
        var note = document.getElementById('formNote');
        if (note) note.hidden = false;
        window.location.href =
          'mailto:goodluck@astrotobby.site?subject=' +
          encodeURIComponent(subject) +
          '&body=' +
          encodeURIComponent(body);
      });
    })();
  </script>
</Layout>

<style>
  .contact-lede { font-size: 1.25rem; color: var(--text-body); margin-bottom: 2.5rem; }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 2rem 0 1rem;
  }
  .contact-card { padding: 2rem; }
  .contact-icon {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: 14px;
    color: #fff;
    background: var(--brand-gradient);
    box-shadow: 0 10px 22px -10px rgba(99, 102, 241, 0.8);
    margin-bottom: 1.25rem;
  }
  .contact-card h3 { margin: 0 0 0.5rem; font-size: 1.3rem; }
  .contact-card > p { color: var(--text-muted); margin-bottom: 1.5rem; }
  .btn { text-decoration: none; }
  .social-list { display: flex; flex-direction: column; gap: 1rem; }
  .social-list a {
    display: flex; align-items: center; gap: 0.85rem;
    font-size: 1.02rem; color: var(--text-body); font-weight: 500;
    padding: 0.5rem 0.75rem; border-radius: 10px;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .social-list a:hover { color: var(--accent); background: var(--accent-soft); transform: translateX(4px); }
  .contact-foot { text-align: center; font-size: 0.9rem; color: var(--text-muted); margin-top: 2.5rem; }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    margin-top: 2rem;
    max-width: 560px;
  }
  .contact-form .field { display: flex; flex-direction: column; gap: 0.4rem; margin: 0; }
  .contact-form label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-heading);
  }
  .contact-form input[type="text"],
  .contact-form input[type="email"],
  .contact-form textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    font: inherit;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm, 10px);
    background: var(--glass-bg-strong, #fff);
    color: var(--text-body);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .contact-form textarea {
    min-height: 130px;
    resize: vertical;
  }
  .contact-form button {
    align-self: flex-start;
    cursor: pointer;
  }
  .form-note { font-size: 0.85rem; color: var(--text-muted); margin: 0.25rem 0 0; }
  @media (max-width: 640px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-form { max-width: 100%; padding: 1.5rem; }
  }
</style>
