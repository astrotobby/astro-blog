---
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="Contact Me"
	description="Get in touch with Astro Tobby"
	pubDate={new Date('June 01 2026')}
	image="/blog-placeholder-about.jpg"
>
	<p>
		Have questions, suggestions, or just want to say hello? I'd love to hear from you. You can reach out to me through the following channels:
	</p>

	<div class="contact-methods">
		<div class="contact-section">
			<h3>Email</h3>
			<p>
				For direct inquiries, please email me at: <br/>
				<a href="mailto:tobby@astrotobby.site" class="email-link">tobby@astrotobby.site</a>
			</p>
		</div>

		<div class="contact-section">
			<h3>Social Media</h3>
			<p>Stay updated and connect with me on social media:</p>
			
			<div class="social-links-grid">
				<a href="https://x.com/AstroboyTobby1" target="_blank" rel="noopener" class="social-card">
					<div class="social-icon-wrapper">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</div>
					<div class="social-info">
						<span class="social-label">X (Twitter)</span>
						<span class="social-handle">@AstroboyTobby1</span>
					</div>
				</a>

				<a href="https://www.instagram.com/astro_tobby/" target="_blank" rel="noopener" class="social-card">
					<div class="social-icon-wrapper">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
					</div>
					<div class="social-info">
						<span class="social-label">Instagram</span>
						<span class="social-handle">@astro_tobby</span>
					</div>
				</a>

				<a href="https://github.com/astrotobby" target="_blank" rel="noopener" class="social-card">
					<div class="social-icon-wrapper">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					</div>
					<div class="social-info">
						<span class="social-label">GitHub</span>
						<span class="social-handle">astrotobby</span>
					</div>
				</a>
			</div>
		</div>
	</div>

	<p class="closing-text">
		I'll do my best to get back to you as soon as possible. Thank you for your interest in my blog!
	</p>
</Layout>

<style>
	.contact-methods {
		margin: 3rem 0;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.contact-section h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		color: #1A1A1A;
	}

	.email-link {
		font-size: 1.25rem;
		font-weight: 600;
		color: #4F46E5;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: all 0.2s ease;
	}

	.email-link:hover {
		border-bottom-color: #4F46E5;
	}

	.social-links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.social-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem;
		background: #F9FAFB;
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: 12px;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.social-card:hover {
		background: #FFFFFF;
		border-color: #4F46E5;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
		transform: translateY(-2px);
	}

	.social-icon-wrapper {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		background: rgba(79, 70, 229, 0.1);
		color: #4F46E5;
		border-radius: 10px;
	}

	.social-info {
		display: flex;
		flex-direction: column;
	}

	.social-label {
		font-size: 0.875rem;
		font-weight: 700;
		color: #718096;
		text-transform: uppercase;
		letter-spacing: 0.025em;
	}

	.social-handle {
		font-size: 1rem;
		font-weight: 600;
		color: #2D3748;
	}

	.closing-text {
		margin-top: 4rem;
		font-style: italic;
		color: #4A5568;
	}

	@media (max-width: 600px) {
		.social-links-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
