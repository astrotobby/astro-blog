---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Newsletter from '../../components/Newsletter.astro';
import { CLUSTERS, postInCluster } from '../../lib/clusters';
import { SITE_TITLE } from '../../consts';

const allPosts = await getCollection('blog');
const clusters = CLUSTERS.map((c) => ({
  ...c,
  count: allPosts.filter((p) => postInCluster((p.data.tags as string[]) ?? [], c)).length,
}));

const title = `Topics — ${SITE_TITLE}`;
const description =
  'Browse every deep dive by topic: AI search & AEO, AI automation, AI agents, and AI coding. Start with a pillar and go as deep as you want.';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .page-header { max-width: var(--maxw); margin: 3.5rem auto 0; padding: 4.5rem 2rem; text-align: center; border-radius: var(--radius-xl); overflow: hidden; }
      .page-title { font-size: clamp(2.4rem, 5vw, 3.5rem); font-weight: 800; margin: 0.5rem 0 1rem; letter-spacing: -0.03em; }
      .page-subtitle { color: var(--text-body); font-size: 1.15rem; max-width: 56ch; margin: 0 auto; }
      .hub-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem; }
      .hub-card { text-decoration: none; display: flex; flex-direction: column; padding: 2rem; border-radius: var(--radius-lg, 20px); }
      .hub-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.6rem; }
      .hub-name { font-size: 1.4rem; font-weight: 800; color: var(--text-heading); margin: 0 0 0.7rem; line-height: 1.25; }
      .hub-answer { font-size: 0.97rem; color: var(--text-body); line-height: 1.6; margin: 0 0 1.1rem; }
      .hub-meta { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
      .hub-count { font-size: 0.85rem; color: var(--text-muted, #64748b); font-weight: 600; }
      .hub-go { font-weight: 700; color: var(--accent); }
      @media (max-width: 700px) { .hub-grid { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="page-header glass" data-reveal>
        <span class="badge"><span class="dot"></span> Topic hubs</span>
        <h1 class="page-title">Browse by <span class="gradient-text">topic</span></h1>
        <p class="page-subtitle">Four pillars covering AI search, automation, agents and coding — each a hub of deep dives plus the tools to act on them.</p>
      </section>

      <section class="section" style="margin: 4rem auto 2rem;">
        <div class="hub-grid">
          {clusters.map((c, i) => (
            <a href={`/topics/${c.slug}/`} class="hub-card card-glass" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
              <p class="hub-eyebrow">{c.eyebrow}</p>
              <h2 class="hub-name">{c.name}</h2>
              <p class="hub-answer">{c.answer}</p>
              <div class="hub-meta">
                <span class="hub-count">{c.count} article{c.count === 1 ? '' : 's'}</span>
                <span class="hub-go">Explore →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <Newsletter />
    </main>
    <Footer />
  </body>
</html>
