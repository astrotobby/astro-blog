---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import AdBanner from '../components/AdBanner.astro';
import AdsterraNativeBanner from '../components/AdsterraNativeBanner.astro';
import Newsletter from '../components/Newsletter.astro';
import ShopifyProducts from '../components/ShopifyProducts.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import InArticleCTA from '../components/InArticleCTA.astro';

import ArticleSchema from '../components/ArticleSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { displayImage, svgFallback } from '../lib/postImage';
import { shouldNoindex } from '../lib/noindex';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string; body?: string; hideHero?: boolean };

const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  tags = [],
  slug = '',
  author = 'Astro Tobby',
  body = '',
  hideHero = false,
} = Astro.props;

const heroImage = displayImage(title, image);
const heroFallback = svgFallback(title);
const noindex = shouldNoindex(slug);
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} ogType="article" noindex={noindex} />
    <ArticleSchema
      title={title}
      description={description}
      pubDate={pubDate}
      updatedDate={updatedDate}
      image={heroImage}
      slug={slug}
      author={author}
    />
    <FAQSchema body={body} />
  </head>
  <body>
    <Header />

    <!-- ═══ TUKO-STYLE: Full-width leaderboard banner BELOW header ═══ -->
    {slug && (
      <div class="post-top-banner" aria-label="Advertisement">
        <span class="post-top-banner__label">Advertisement</span>
        <AdBanner slot="top" minHeight="90px" margin="0 auto" />
      </div>
    )}

    <main>
      <div class="rd-layout">
        <div class="rd-main">
          <article>
            <!-- Breadcrumb -->
            <nav class="rd-crumbs" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span class="sep">›</span>
              <a href="/blog">Blog</a>
              <span class="sep">›</span>
              <span>{title}</span>
            </nav>

            <h1 class="post-title">{title}</h1>

            <!-- Meta row: avatar · author · date -->
            <div class="rd-meta">
              <img class="rd-avatar" src="/astrosignal-logo.png" alt={author} width="34" height="34" decoding="async" />
              <span class="rd-author">{author}</span>
              <span class="rd-dot">·</span>
              <span><FormattedDate date={pubDate} /></span>
              {updatedDate && (
                <>
                  <span class="rd-dot">·</span>
                  <span class="last-updated-on">Updated <FormattedDate date={updatedDate} /></span>
                </>
              )}
            </div>

            {heroImage && !hideHero && (
              <div class="post-hero">
                <img src={heroImage} alt={title} onerror={`this.onerror=null;this.src='${heroFallback}'`} />
              </div>
            )}

            <!-- ═══ TUKO-STYLE: In-article banner AFTER hero image ═══ -->
            {slug && (
              <div class="post-in-article-banner" aria-label="Advertisement">
                <span class="post-banner__label">Advertisement</span>
                <AdBanner slot="middle1" minHeight="100px" margin="0 auto" />
              </div>
            )}

            <div class="prose">
              <slot />
              <!-- ═══ TUKO-STYLE: Mid-article banner ═══ -->
              {slug && (
                <div class="post-mid-banner" aria-label="Advertisement">
                  <span class="post-banner__label">Advertisement</span>
                  <AdBanner slot="middle2" minHeight="100px" margin="0 auto" />
                </div>
              )}
              <!-- Bottom of article banner -->
              {slug && (
                <div class="post-bottom-banner" aria-label="Advertisement">
                  <span class="post-banner__label">Advertisement</span>
                  <AdBanner slot="bottom" minHeight="90px" margin="0 auto" />
                </div>
              )}
            </div>
          </article>
        </div>

        <Sidebar currentId={slug} limit={5} />
      </div>

      <!-- Conversion zone: the reader's own topic → matching offer comes FIRST,
           before any ad unit, so the product is never buried below the ads. -->
      <InArticleCTA tags={tags} />

      <ShopifyProducts tags={tags} limit={3} />

      

      {slug && <RelatedPosts currentSlug={slug} tags={tags} />}

      <Newsletter />

      <!-- Adsterra native banner. The component relocates itself into the MIDDLE
           of the article body (between paragraphs) on load, so it renders in-article
           rather than at the page bottom. Kept mounted here as the no-JS fallback. -->
      <AdsterraNativeBanner />
    </main>
    <Footer />

    <style>
      /* ── Article title & hero ── */
      .post-title { font-size: clamp(1.9rem, 4vw, 2.6rem); margin: 0 0 0.4rem; }
      .post-hero { margin: 0.5rem 0 1.8rem; border-radius: var(--radius); overflow: hidden; box-shadow: var(--box-shadow); }
      .post-hero img { width: 100%; height: auto; display: block; }
      .last-updated-on { font-style: italic; }

      /* ── Tuko-style: Full-width leaderboard banner below header ── */
      .post-top-banner {
        width: 100%;
        background: var(--bg-primary);
        border-bottom: 1px solid var(--border-light);
        padding: 0.5rem 1.5rem 0.75rem;
        text-align: center;
      }
      .post-top-banner__label {
        display: block;
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted, #9ca3af);
        margin-bottom: 0.35rem;
      }
      /* Ensure the top banner's AdBanner fills full width */
      .post-top-banner :global(.monetag-banner-slot) {
        max-width: 970px;
        min-height: 90px;
      }

      /* ── Shared banner label ── */
      .post-banner__label {
        display: block;
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted, #9ca3af);
        margin-bottom: 0.35rem;
      }

      /* ── Tuko-style: In-article banner after hero image ── */
      .post-in-article-banner {
        margin: 0 0 1.75rem;
        padding: 0.5rem 0 0.75rem;
        border-top: 1px solid var(--border-light);
        border-bottom: 1px solid var(--border-light);
        text-align: center;
        background: var(--bg-secondary, #f8f9fc);
        border-radius: var(--radius-sm, 6px);
      }

      /* ── Mid-article and bottom banners ── */
      .post-mid-banner,
      .post-bottom-banner {
        margin: 2rem 0;
        padding: 0.5rem 0 0.75rem;
        border-top: 1px solid var(--border-light);
        border-bottom: 1px solid var(--border-light);
        text-align: center;
        background: var(--bg-secondary, #f8f9fc);
        border-radius: var(--radius-sm, 6px);
      }

      /* ── Ensure all in-article banners have proper sizing ── */
      .post-in-article-banner :global(.monetag-banner-slot),
      .post-mid-banner :global(.monetag-banner-slot),
      .post-bottom-banner :global(.monetag-banner-slot) {
        max-width: 728px;
        min-height: 100px;
      }
    </style>
  </body>
</html>
