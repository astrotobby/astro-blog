---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import AdBanner from '../components/AdBanner.astro';
import AdsterraNativeBanner from '../components/AdsterraNativeBanner.astro';
import Newsletter from '../components/Newsletter.astro';
import ShopifyProducts from '../components/ShopifyProducts.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import InArticleCTA from '../components/InArticleCTA.astro';
import OfferStrip from '../components/OfferStrip.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { displayImage, svgFallback } from '../lib/postImage';
import { shouldNoindex } from '../lib/noindex';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string; body?: string; hideHero?: boolean };

const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  tags = [],
  slug = '',
  author = 'Astro Tobby',
  body = '',
  hideHero = false,
} = Astro.props;

const heroImage = displayImage(title, image);
const heroFallback = svgFallback(title);
const noindex = shouldNoindex(slug);
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} ogType="article" noindex={noindex} />
    <ArticleSchema
      title={title}
      description={description}
      pubDate={pubDate}
      updatedDate={updatedDate}
      image={heroImage}
      slug={slug}
      author={author}
    />
    <FAQSchema body={body} />
  </head>
  <body>
    <Header />
    <main>
      <div class="rd-layout">
        <div class="rd-main">
          <article>
            <!-- Breadcrumb -->
            <nav class="rd-crumbs" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span class="sep">›</span>
              <a href="/blog">Blog</a>
              <span class="sep">›</span>
              <span>{title}</span>
            </nav>

            <h1 class="post-title">{title}</h1>

            <!-- Meta row: avatar · author · date -->
            <div class="rd-meta">
              <img class="rd-avatar" src="/astrosignal-logo.png" alt={author} width="34" height="34" decoding="async" />
              <span class="rd-author">{author}</span>
              <span class="rd-dot">·</span>
              <span><FormattedDate date={pubDate} /></span>
              {updatedDate && (
                <>
                  <span class="rd-dot">·</span>
                  <span class="last-updated-on">Updated <FormattedDate date={updatedDate} /></span>
                </>
              )}
            </div>

            {heroImage && !hideHero && (
              <div class="post-hero">
                <img src={heroImage} alt={title} onerror={`this.onerror=null;this.src='${heroFallback}'`} />
              </div>
            )}

            <div class="prose">
              {slug && <AdBanner slot="top" />}
              <slot />
              {slug && <AdBanner slot="middle1" />}
              {slug && <AdBanner slot="bottom" />}
            </div>
          </article>
        </div>

        <Sidebar currentId={slug} limit={5} />
      </div>

      <!-- Conversion zone: the reader's own topic → matching offer comes FIRST,
           before any ad unit, so the product is never buried below the ads. -->
      <InArticleCTA tags={tags} />

      <ShopifyProducts tags={tags} limit={3} />

      <OfferStrip title="Free Offers For You" subid={slug ? `post-${slug}` : 'blogpost'} limit={4} />

      {slug && <RelatedPosts currentSlug={slug} tags={tags} />}

      <Newsletter />

      <!-- Adsterra native banner. The component relocates itself into the MIDDLE
           of the article body (between paragraphs) on load, so it renders in-article
           rather than at the page bottom. Kept mounted here as the no-JS fallback. -->
      <AdsterraNativeBanner />
    </main>
    <Footer />

    <style>
      .post-title { font-size: clamp(1.9rem, 4vw, 2.6rem); margin: 0 0 0.4rem; }
      .post-hero { margin: 0.5rem 0 1.8rem; border-radius: var(--radius); overflow: hidden; box-shadow: var(--box-shadow); }
      .post-hero img { width: 100%; height: auto; display: block; }
      .last-updated-on { font-style: italic; }
    </style>
  </body>
</html>
