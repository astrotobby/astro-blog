---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AdBanner from '../components/AdBanner.astro';
import AdsterraNativeBanner from '../components/AdsterraNativeBanner.astro';
import Newsletter from '../components/Newsletter.astro';
import ShopifyProducts from '../components/ShopifyProducts.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import InArticleCTA from '../components/InArticleCTA.astro';
import OfferStrip from '../components/OfferStrip.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { displayImage, svgFallback } from '../lib/postImage';
import { shouldNoindex } from '../lib/noindex';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string; body?: string; hideHero?: boolean };

const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  tags = [],
  slug = '',
  author = 'Astro Tobby',
  body = '',
  hideHero = false,
} = Astro.props;

const heroImage = displayImage(title, image);
const heroFallback = svgFallback(title);
const noindex = shouldNoindex(slug);
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} ogType="article" noindex={noindex} />
    <ArticleSchema
      title={title}
      description={description}
      pubDate={pubDate}
      updatedDate={updatedDate}
      image={heroImage}
      slug={slug}
      author={author}
    />
    <FAQSchema body={body} />
  </head>
  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          <a href="/blog">&larr; Back to archive</a>
          {heroImage && !hideHero && (
            <img
              src={heroImage}
              alt={title}
              onerror={`this.onerror=null;this.src='${heroFallback}'`}
            />
          )}
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <div class="last-updated-on">
                  (Updated: <FormattedDate date={updatedDate} />)
                </div>
              )}
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          {slug && <AdBanner slot="top" />}
          <slot />
          {slug && <AdBanner slot="bottom" />}
        </div>
      </article>

      <!-- Conversion zone: the reader's own topic → matching offer comes FIRST,
           before any ad unit, so the product is never buried below the ads. -->
      <InArticleCTA tags={tags} />

      <ShopifyProducts tags={tags} limit={3} />

      <OfferStrip title="Free Offers For You" subid={slug ? `post-${slug}` : 'blogpost'} limit={4} />

      {slug && <RelatedPosts currentSlug={slug} tags={tags} />}

      <Newsletter />

      <!-- Ad moved to the very bottom so it can't outrank our own products. -->
      <AdsterraNativeBanner />
    </main>
    <Footer />
  </body>
</html>
