---
---
<section class="newsletter-section">
    <div class="newsletter-container">
        <div class="newsletter-content">
            <h2>Get the free 2026 AI Starter Pack</h2>
            <p>20 plug-and-play AI prompts + 3 zero-budget automation recipes — instant, free. Plus new posts when they drop.</p>
        </div>
        <form id="newsletter-form" class="newsletter-form">
            <div class="input-group">
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="Enter your email" 
                    required 
                    aria-label="Email address"
                />
                <button type="submit" id="submit-btn">
                    <span>Get the pack</span>
                    <svg class="spinner" viewBox="0 0 24 24" style="display: none;">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                    </svg>
                </button>
            </div>
            <p id="form-message" class="form-message"></p>
        </form>
    </div>
</section>

<style>
    .newsletter-section {
        position: relative;
        color: white;
        padding: 4rem 2rem;
        border-radius: var(--radius-xl, 32px);
        margin: 4rem 0;
        overflow: hidden;
        background: linear-gradient(135deg, #1b1d3a 0%, #312e81 55%, #4f46e5 100%);
        box-shadow: 0 24px 48px -16px rgba(31, 38, 90, 0.45);
    }
    .newsletter-section::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(40% 60% at 85% 10%, rgba(236, 72, 153, 0.45), transparent 60%),
                    radial-gradient(45% 55% at 10% 95%, rgba(6, 182, 212, 0.4), transparent 60%);
        pointer-events: none;
    }

    .newsletter-container {
        position: relative;
        z-index: 1;
        max-width: 600px;
        margin: 0 auto;
        text-align: center;
    }

    .newsletter-content h2 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 1rem;
        color: white;
    }

    .newsletter-content p {
        color: rgba(255, 255, 255, 0.82);
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    .newsletter-form {
        width: 100%;
    }

    .input-group {
        display: flex;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.08);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
        padding: 0.5rem;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.18);
    }
    .input-group:focus-within {
        border-color: rgba(255, 255, 255, 0.5);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.25);
    }

    input[type="email"] {
        flex: 1;
        background: transparent;
        border: none;
        color: white;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        outline: none;
    }

    input[type="email"]::placeholder {
        color: #718096;
    }

    button {
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #EC4899 100%);
        background-size: 160% 160%;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.18s cubic-bezier(0.22,1,0.36,1), background-position 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 120px;
    }

    button:hover {
        transform: translateY(-2px);
        background-position: 100% 50%;
        box-shadow: 0 12px 24px -10px rgba(236, 72, 153, 0.6);
    }

    button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .form-message {
        margin-top: 1rem;
        font-size: 0.9rem;
        min-height: 1.25rem;
    }

    .form-message.success {
        color: #48bb78;
    }

    .form-message.error {
        color: #f56565;
    }

    .spinner {
        animation: rotate 2s linear infinite;
        width: 20px;
        height: 20px;
        margin-left: 8px;
    }

    .spinner circle {
        stroke-dasharray: 62;
        stroke-dashoffset: 0;
        transform-origin: center;
        animation: dash 1.5s ease-in-out infinite;
    }

    @keyframes rotate {
        100% { transform: rotate(360deg); }
    }

    @keyframes dash {
        0% { stroke-dashoffset: 62; }
        50% { stroke-dashoffset: 15; transform: rotate(135deg); }
        100% { stroke-dashoffset: 62; transform: rotate(450deg); }
    }

    @media (max-width: 480px) {
        .input-group {
            flex-direction: column;
        }
        button {
            width: 100%;
        }
    }
</style>

<script>
    const form = document.getElementById('newsletter-form') as HTMLFormElement;
    const messageEl = document.getElementById('form-message');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const spinner = submitBtn?.querySelector('.spinner') as HTMLElement;
    const btnText = submitBtn?.querySelector('span') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const email = formData.get('email');

        if (!email) return;

        // Reset state
        if (messageEl) {
            messageEl.textContent = '';
            messageEl.className = 'form-message';
        }
        if (submitBtn) submitBtn.disabled = true;
        if (spinner) spinner.style.display = 'block';
        if (btnText) btnText.textContent = 'Subscribing...';

        try {
            const response = await fetch('/api/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });

            const data = await response.json();

            if (response.ok) {
                if (messageEl) {
                    messageEl.innerHTML = "You're in! 🎉 <a href=\"/free/ai-starter-pack.html\" style=\"color:#fff;text-decoration:underline;font-weight:700\">Grab your free Starter Pack →</a>";
                    messageEl.classList.add('success');
                }
                form.reset();
            } else {
                throw new Error(data.error || 'Something went wrong');
            }
        } catch (err) {
            if (messageEl) {
                messageEl.textContent = err instanceof Error ? err.message : 'Failed to subscribe. Please try again.';
                messageEl.classList.add('error');
            }
        } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (spinner) spinner.style.display = 'none';
            if (btnText) btnText.textContent = 'Get the pack';
        }
    });
</script>
