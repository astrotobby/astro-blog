---
import { fetchShopifyProducts, prioritizeProducts } from '../lib/shopify';
import type { ShopifyProduct } from '../lib/shopify';

interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;

// Fallback static list — rendered if Shopify API is unavailable (e.g. missing env var in dev)
const FALLBACK: ShopifyProduct[] = [
  {
    id: 'gid://shopify/Product/10365512286487',
    title: 'The AI Video Freelancer Toolkit 2026 — Land Clients, Deliver AI Videos, Get Paid',
    status: 'ACTIVE', vendor: 'Astro Tobby', productType: 'Digital Download',
    totalVariants: 1, totalInventory: 0,
    createdAt: '2026-06-09T09:05:47Z', updatedAt: '2026-06-09T21:34:21Z',
    handle: 'ai-video-freelancer-toolkit-2026',
    variantId: 'gid://shopify/ProductVariant/53517875675415',
    price: '$24.00',
    description: 'Master AI video creation and land high-paying clients with this comprehensive toolkit.',
  },
  {
    id: 'gid://shopify/Product/10365578838295',
    title: 'Make.com Autoblogging Blueprint 2026 — Build a Full AI Content Pipeline',
    status: 'ACTIVE', vendor: 'Astro Tobby', productType: 'Digital Download',
    totalVariants: 1, totalInventory: 0,
    createdAt: '2026-06-09T10:22:51Z', updatedAt: '2026-06-10T03:58:42Z',
    handle: 'make-com-autoblogging-blueprint-2026-build-a-full-ai-content-pipeline',
    variantId: 'gid://shopify/ProductVariant/53518038434071',
    price: '$22.00',
    description: 'Build an automated content creation pipeline using Make.com and AI.',
  },
  {
    id: 'gid://shopify/Product/10365579297047',
    title: 'AI Prompt Vault 2026 — 500+ Categorized Prompts for Video, Content, Code & Automation',
    status: 'ACTIVE', vendor: 'Astro Tobby', productType: 'Digital Download',
    totalVariants: 1, totalInventory: 0,
    createdAt: '2026-06-09T10:23:15Z', updatedAt: '2026-06-10T03:58:43Z',
    handle: 'ai-prompt-vault-2026-500-categorized-prompts-for-video-content-code-automation',
    variantId: 'gid://shopify/ProductVariant/53518039417111',
    price: '$12.00',
    description: 'Access 500+ expertly crafted prompts for AI video, content creation, coding, and automation.',
  },
  {
    id: 'gid://shopify/Product/10365579821335',
    title: 'AEO Masterguide 2026 — Rank in AI Search (ChatGPT, Perplexity, Google AI Overviews)',
    status: 'ACTIVE', vendor: 'Astro Tobby', productType: 'Digital Download',
    totalVariants: 1, totalInventory: 0,
    createdAt: '2026-06-09T10:23:38Z', updatedAt: '2026-06-10T03:58:43Z',
    handle: 'aeo-masterguide-2026-rank-in-ai-search-chatgpt-perplexity-google-ai-overviews',
    variantId: 'gid://shopify/ProductVariant/53518039417111',
    price: '$14.00',
    description: 'Learn Answer Engine Optimization to rank your content in AI search engines.',
  },
  {
    id: 'gid://shopify/Product/10365580312855',
    title: 'Agentic AI Workflow Pack 2026 — Build & Deploy Multi-Agent Systems Without Code',
    status: 'ACTIVE', vendor: 'Astro Tobby', productType: 'Digital Download',
    totalVariants: 1, totalInventory: 0,
    createdAt: '2026-06-09T10:23:59Z', updatedAt: '2026-06-10T03:58:43Z',
    handle: 'agentic-ai-workflow-pack-2026-build-amp-deploy-multi-agent-systems-without-code',
    variantId: 'gid://shopify/ProductVariant/53518039908631',
    price: '$32.00',
    description: 'Build and deploy multi-agent AI systems without writing any code.',
  },
];

let raw: ShopifyProduct[] = FALLBACK;
try {
  raw = await fetchShopifyProducts();
} catch (e) {
  console.warn('[ShopifyProducts] Using fallback data:', (e as Error).message);
}

const products = prioritizeProducts(raw, tags);
const storeBase = 'https://chainztobby.myshopify.com';
---

<section class="sp-section" aria-label="Recommended Resources">
  <header class="sp-header" data-reveal>
    <p class="sp-eyebrow">From the store</p>
    <h2 class="sp-title gradient-text">Level Up Your Toolkit</h2>
    <p class="sp-subtitle">Practical digital guides you can apply today</p>
  </header>

  <div class="sp-grid">
    {products.map((product, i) => {
      const variantId = product.variantId.split('/').pop();
      const cartUrl = `${storeBase}/cart/add?id=${variantId}`;
      const pdpUrl = `${storeBase}/products/${product.handle}`;
      const isFeatured = i === 0;
      return (
        <article class={`sp-card${isFeatured ? ' sp-card--featured' : ''}`} data-reveal style={`--reveal-delay:${i * 60}ms`}>
          {isFeatured && <span class="sp-featured-badge">Top Pick for This Article</span>}
          <div class="sp-card-top">
            <span class="sp-badge">{product.productType}</span>
            <span class="sp-price">{product.price}</span>
          </div>
          <h3 class="sp-card-title">
            <a href={pdpUrl} target="_blank" rel="noopener noreferrer">{product.title}</a>
          </h3>
          <p class="sp-card-desc">{product.description}</p>
          <div class="sp-card-footer">
            <a href={pdpUrl} class="sp-link" target="_blank" rel="noopener noreferrer">Learn more</a>
            <a href={cartUrl} class="sp-btn" target="_blank" rel="noopener noreferrer">
              Add to Cart
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </article>
      );
    })}
  </div>

  <div class="sp-store-link" data-reveal>
    <a href={`${storeBase}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
      Browse the full store →
    </a>
  </div>
</section>

<style>
  .sp-section { margin: 4rem 0 0; }

  .sp-header { text-align: center; margin-bottom: 2.5rem; }
  .sp-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .sp-title { font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 800; margin: 0 0 0.5rem; }
  .sp-subtitle { color: var(--text-body); font-size: 1rem; margin: 0; }

  .sp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .sp-card {
    background: var(--glass-bg, rgba(255,255,255,0.6));
    border: 1px solid var(--glass-border, rgba(99,102,241,0.15));
    border-radius: var(--radius-lg, 20px);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    transition: transform 0.22s var(--ease-out, ease), box-shadow 0.22s var(--ease-out, ease);
    -webkit-backdrop-filter: blur(var(--glass-blur, 14px));
    backdrop-filter: blur(var(--glass-blur, 14px));
  }
  .sp-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift, 0 16px 40px -10px rgba(79,70,229,0.18));
  }
  .sp-card--featured {
    border-color: var(--accent, #4F46E5);
    box-shadow: 0 0 0 2px var(--accent, #4F46E5), var(--shadow-glass, 0 8px 24px rgba(0,0,0,0.07));
  }

  .sp-featured-badge {
    position: absolute;
    top: -12px;
    left: 1.25rem;
    background: var(--brand-gradient, linear-gradient(90deg,#6366F1,#EC4899));
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .sp-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sp-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(79,70,229,0.1);
    color: var(--accent, #4F46E5);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .sp-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent, #4F46E5);
  }

  .sp-card-title {
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-heading, #1a1a2e);
    margin: 0;
    flex-grow: 1;
  }
  .sp-card-title a { color: inherit; text-decoration: none; }
  .sp-card-title a:hover { color: var(--accent); }

  .sp-card-desc {
    font-size: 0.875rem;
    color: var(--text-body, #555);
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }

  .sp-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--glass-border, rgba(0,0,0,0.06));
    margin-top: auto;
  }
  .sp-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent, #4F46E5);
    text-decoration: none;
  }
  .sp-link:hover { text-decoration: underline; }

  .sp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--brand-gradient, linear-gradient(135deg,#6366F1,#8B5CF6));
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    transition: opacity 0.18s, transform 0.18s;
    white-space: nowrap;
  }
  .sp-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  .sp-store-link { text-align: center; margin-top: 2rem; }

  @media (max-width: 640px) {
    .sp-grid { grid-template-columns: 1fr; }
  }
</style>
