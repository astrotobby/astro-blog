---
// ShopifyProducts.astro - Fetches and displays Shopify products
// This component is designed to be reusable across blog posts

interface Product {
  id: string;
  title: string;
  status: string;
  vendor: string;
  productType: string;
  totalVariants: number;
  totalInventory: number;
  createdAt: string;
  updatedAt: string;
  handle?: string;
  variantId?: string;
  price?: string;
  description?: string;
}

// Fetch products from Shopify using the MCP API
// In a real deployment, this would call your backend API or use Shopify Storefront API
const getShopifyProducts = async (): Promise<Product[]> => {
  try {
    // For now, we'll use hardcoded data that matches your store
    // In production, you'd fetch this from your backend API or Shopify Storefront API
    const products: Product[] = [
      {
