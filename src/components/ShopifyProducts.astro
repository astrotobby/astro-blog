};

const products = await getShopifyProducts();
---

<section class="shopify-products-section">
  <div class="shopify-container">
    <div class="section-header">
      <h2>Recommended Resources</h2>
      <p>Explore curated tools and guides to accelerate your AI journey</p>
    </div>

    <div class="products-grid">
      {products.map((product) => (
        <div class="product-card">
          <div class="product-header">
            <span class="product-badge">{product.productType}</span>
            <span class="product-vendor">{product.vendor}</span>
          </div>
          
          <h3 class="product-title">{product.title}</h3>
          
          <p class="product-description">{product.description}</p>
          
          <div class="product-footer">
            <span class="product-price">{product.price}</span>
            <a 
              href={`https://chainztobby.myshopify.com/cart/add?id=${product.variantId?.split('/').pop()}`}
              class="product-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              Buy Now →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .shopify-products-section {
    background: transparent;
    padding: 0;
    border-radius: 0;
    margin: 0;
  }

  .shopify-container {
    max-width: 100%;
  }

  .section-header {
    display: none;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 800;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
  }

  .section-header p {
    font-size: 1.1rem;
    color: #666;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .product-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  }

  .product-card:hover {
    box-shadow: 0 20px 40px rgba(102, 126, 234, 0.15);
    transform: translateY(-8px);
  }

  .product-header {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .product-badge {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-vendor {
    background: rgba(79, 70, 229, 0.1);
    color: #4F46E5;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
  }

  .product-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.75rem;
    line-height: 1.4;
    flex-grow: 1;
  }

  .product-description {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 1.5rem;
    line-height: 1.5;
    flex-grow: 1;
  }

  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .product-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: #4F46E5;
  }

  .product-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  }

  .product-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(102, 126, 234, 0.4);
  }

  @media (max-width: 768px) {
    .shopify-products-section {
      padding: 2rem 1rem;
    }

    .section-header h2 {
      font-size: 1.5rem;
    }

    .products-grid {
      grid-template-columns: 1fr;
    }

    .product-card {
      padding: 1.25rem;
    }
  }
</style>
