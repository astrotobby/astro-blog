---
// Emits BlogPosting + BreadcrumbList JSON-LD so AI engines (ChatGPT, Perplexity,
// Google AI Overviews) and search crawlers can cite the post with full context.
// This is the on-page half of the AEO strategy in growth-engine/00-TRAFFIC-ENGINE-PLAN.md.
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  image?: string;
  slug: string;
  author?: string;
}

const { title, description = '', pubDate, updatedDate, image, slug, author = 'Astro Tobby' } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://astrotobby.site';
const pageUrl = `${site}/blog/${slug}/`;
const logo = `${site}/favicon.svg`;
const imageUrl = image
  ? (image.startsWith('http') ? image : `${site}${image.startsWith('/') ? '' : '/'}${image}`)
  : `${site}/favicon.svg`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: imageUrl,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: author, url: `${site}/about` },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    logo: { '@type': 'ImageObject', url: logo },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
