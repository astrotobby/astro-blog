---
interface Props {
	minHeight?: string;
	margin?: string;
	slot?: string;
}

const { minHeight = "90px", margin = "20px auto", slot } = Astro.props;

// Zone IDs for banner placements (728x90 / 300x250 style)
// We'll use different zones for different slots to maximize fill rate
const ZONE_MAP: Record<string, string> = {
  'top': '11189587',      // Great tag
  'middle1': '10979500',  // Wonderful tag
  'middle2': '10964339',  // Excited tag (MULTI)
  'bottom': '11242710',   // Lovely tag
  'sidebar-top': '11244264' // Excited tag
};

const currentZone = ZONE_MAP[slot || 'top'] || '11189587';
const uniqueId = `monetag-banner-${currentZone}-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="monetag-banner-slot" id={uniqueId} data-zone={currentZone} style={`min-height: ${minHeight}; margin: ${margin};`}></div>

<script is:inline define:vars={{ zone: currentZone, adElementId: uniqueId }}>
  (function() {
    var el = document.getElementById(adElementId);
    if (!el) return;

    // Create and inject the Monetag script
    // Monetag's adsterra.js expects to be able to find its parent container.
    // We use a small delay to ensure the DOM is stable and the container is ready.
    setTimeout(function() {
      var s = document.createElement('script');
      s.type = 'text/javascript';
      s.src = '//fe.monetag.com/ads/adsterra.js';
      s.setAttribute('data-zone-id', zone);
      s.async = true;
      el.appendChild(s);
    }, 100);
  })();
</script>

<style>
	.monetag-banner-slot {
		min-height: 90px;
		width: 100%;
		max-width: 728px;
		margin: 20px auto;
		display: block;
	}
</style>
