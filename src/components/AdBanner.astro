---
interface Props {
	minHeight?: string;
	margin?: string;
	slot?: string;
}

const { minHeight, margin = "20px auto", slot } = Astro.props;

/**
 * Adsterra Iframe Keys provided by the user:
 * 1. 728x90 (Leaderboard) - for horizontal content slots
 * 2. 300x250 (Rectangle) - for sidebar top
 * 3. 160x600 (Skyscraper) - for sidebar bottom
 */
const keys = {
  leaderboard: '69653a4377aeaa881f9eb1c36e09704b',
  rectangle: 'f1cac584b80eaf7c7b3dc78c37cd54df',
  skyscraper: '1b3ede9e9965480f3c9e13de0dc2dc40'
};

let iframeKey = keys.leaderboard;
let width = 728;
let height = 90;
let defaultMinHeight = "90px";

if (slot === 'sidebar-top') {
  iframeKey = keys.rectangle;
  width = 300;
  height = 250;
  defaultMinHeight = "250px";
} else if (slot === 'sidebar-bottom') {
  iframeKey = keys.skyscraper;
  width = 160;
  height = 600;
  defaultMinHeight = "600px";
}

const finalMinHeight = minHeight || defaultMinHeight;
const containerId = `ad-slot-${slot || 'default'}-${Math.floor(Math.random() * 10000)}`;
---

<div class="adsterra-banner-slot" style={`min-height: ${finalMinHeight}; margin: ${margin};`}>
  <div class="ad-iframe-wrapper" id={containerId}>
    <script is:inline define:vars={{ iframeKey, width, height }}>
      // Set the global atOptions for the following invoke.js script
      window.atOptions = {
        'key' : iframeKey,
        'format' : 'iframe',
        'height' : height,
        'width' : width,
        'params' : {}
      };
    </script>
    <script is:inline type="text/javascript" src={`https://www.highperformanceformat.com/${iframeKey}/invoke.js`}></script>
  </div>
</div>

<style>
	.adsterra-banner-slot {
		width: 100%;
		display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
	}
  .ad-iframe-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }
</style>
