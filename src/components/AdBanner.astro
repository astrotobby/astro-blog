---
interface Props {
	minHeight?: string;
	margin?: string;
	slot?: string;
}

const { minHeight = "90px", margin = "20px auto", slot } = Astro.props;

// Zone IDs for banner placements (728x90 / 300x250 style)
// We'll use different zones for different slots to maximize fill rate
const ZONE_MAP: Record<string, string> = {
  'top': '11189587',      // Great tag
  'middle1': '10979500',  // Wonderful tag
  'middle2': '10964339',  // Excited tag (MULTI)
  'bottom': '11242710',   // Lovely tag
  'sidebar-top': '11244264' // Excited tag
};

const currentZone = ZONE_MAP[slot || 'top'] || '11189587';
---

<div class="monetag-banner-slot" style={`min-height: ${minHeight}; margin: ${margin};`}>
  <!--
    Monetag banner ad — zone injected via nap5k.com (Monetag's working CDN).
    The script reads data-zone from its own element.
    One <script> per slot so each zone renders independently.
  -->
  <script is:inline define:vars={{ zone: currentZone }}>
    (function () {
      var s = document.createElement('script');
      s.setAttribute('data-zone', zone);
      s.src = 'https://nap5k.com/tag.min.js';
      s.async = true;
      document.body.appendChild(s);
    })();
  </script>
</div>

<style>
	.monetag-banner-slot {
		min-height: 90px;
		width: 100%;
		max-width: 728px;
		margin: 20px auto;
		display: block;
	}
</style>
