---
// Third-party ad network scripts (Monetag, HilltopAds), injected client-side
// after a short idle delay so they never block first paint or hurt Core Web
// Vitals. The full-screen/autoplay formats (vignette, video-slide) are capped
// to once per browser session so a reader isn't hit on every single page —
// the banner format can run every page view.
// Note: Monetag in-page push (fake notification popups) was removed per
// explicit request — too intrusive/spammy-looking.
// These networks render as floating/fixed-position widgets rather than
// inline elements, so they can't be placed "after" content in document flow.
// Instead: once the visitor reaches the Shopify products section (.sp-section),
// we stop injecting any ad that hasn't already loaded, so ads never show
// alongside/after the product showcase.
---

<script is:inline>
  (function () {
    var blockedByProducts = false;

    function watchProductsSection() {
      var section = document.querySelector('.sp-section');
      if (!section || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            blockedByProducts = true;
            io.disconnect();
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.01 });
      io.observe(section);
    }

    function loadAlways(src, zone) {
      if (blockedByProducts) return;
      var s = document.createElement('script');
      if (zone) s.dataset.zone = zone;
      s.src = src;
      s.async = true;
      document.body.appendChild(s);
    }

    function loadOncePerSession(key, src) {
      if (blockedByProducts) return;
      var flagKey = 'ad_' + key + '_shown';
      if (sessionStorage.getItem(flagKey)) return;
      sessionStorage.setItem(flagKey, '1');
      var s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.referrerPolicy = 'no-referrer-when-downgrade';
      document.body.appendChild(s);
    }

    function boot() {
      // HilltopAds — banner (lightweight, every page view)
      loadAlways('//relieved-understanding.com/blXtVvsQd.GblY0/YkW/ch/reWmK9-uGZzUVluk/PQTtc/xDN_D-gpylMzjiEitCNizPEU0/ORDTI/y/N/Qd');

      // Monetag — vignette (full-screen interstitial, capped to once per session)
      loadOncePerSession('vignette', 'https://n6wxm.com/vignette.min.js');

      // HilltopAds — video slide (autoplay slide-in video, capped to once per session)
      loadOncePerSession('videoslide', '//surefootedpause.com/dYm.FEzXdkGZNzvCZgGKUk/Heem/9tuSZWUHlXkOPrTxcYxBNEDWgUy_NLjnE/tbNwz/Eg0dOQDOIj2BN-QY');
    }

    // Wait until the page is idle (or ~2s fallback) before injecting anything,
    // so these never compete with the page's own initial render.
    function schedule() {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(boot, { timeout: 3000 });
      } else {
        setTimeout(boot, 2000);
      }
    }

    function start() {
      watchProductsSection();
      schedule();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
</script>
