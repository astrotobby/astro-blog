---
// Third-party ad network scripts, injected immediately on visit (right after
// DOMContentLoaded, async — won't block rendering).
// Scope: in-page format only (Monetag). Popup/interstitial (Monetag vignette)
// and HilltopAds banner were both removed per explicit request — only
// in-page + native bar formats are wanted (see AdsterraNativeBanner.astro
// for the native bar).
// Once the visitor reaches the Shopify products section (.sp-section), we
// (a) stop injecting any ad that hasn't already loaded, AND (b) forcibly
// hide any ad widget already on screen, so nothing lingers into the
// footer/newsletter area below the products.
---

<script is:inline>
  (function () {
    var blockedByProducts = false;
    var trackedNodes = [];
    var bodyObserver = null;

    function hideTrackedNodes() {
      trackedNodes.forEach(function (node) {
        if (!node || !node.style) return;
        try {
          node.style.setProperty('display', 'none', 'important');
          node.style.setProperty('visibility', 'hidden', 'important');
          node.style.setProperty('pointer-events', 'none', 'important');
        } catch (e) {}
      });
    }

    // Track every node ad scripts add directly to <body> (their iframes/
    // widgets typically attach there) so we can kill them on demand.
    function startTracking() {
      if (!('MutationObserver' in window)) return;
      bodyObserver = new MutationObserver(function (mutations) {
        mutations.forEach(function (m) {
          m.addedNodes.forEach(function (node) {
            if (node.nodeType === 1) {
              trackedNodes.push(node);
              if (blockedByProducts) hideTrackedNodes();
            }
          });
        });
      });
      bodyObserver.observe(document.body, { childList: true });
    }

    function watchProductsSection() {
      var section = document.querySelector('.sp-section');
      if (!section || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            blockedByProducts = true;
            hideTrackedNodes();
            io.disconnect();
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.01 });
      io.observe(section);
    }

    function loadAlways(src, zone) {
      if (blockedByProducts) return;
      var s = document.createElement('script');
      if (zone) s.dataset.zone = zone;
      s.src = src;
      s.async = true;
      document.body.appendChild(s);
    }

    function boot() {
      // Monetag — in-page push only (verified 200 OK). Zone updated per
      // latest request. Vignette (popup) and HilltopAds banner removed.
      loadAlways('https://nap5k.com/tag.min.js', '11189587');
    }

    function start() {
      startTracking();
      watchProductsSection();
      boot();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
</script>
