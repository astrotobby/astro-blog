---
// Auto-derives FAQPage JSON-LD from a post's question-shaped headings + the text
// that follows each — the single highest-leverage AEO signal (it's what Google AI
// Overviews, ChatGPT and Perplexity lift into answers). Zero manual work per post:
// any heading phrased as a question becomes an eligible FAQ entry. Renders nothing
// unless the post has at least 2 real question/answer pairs.
interface Props {
  body: string;
}
const { body = '' } = Astro.props;

function stripTags(s: string): string {
  return s
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')
    .replace(/&#39;|&rsquo;|&lsquo;/g, "'").replace(/&quot;|&ldquo;|&rdquo;/g, '"')
    .replace(/&[a-z]+;/gi, ' ')
    // markdown syntax: images, links, emphasis/code/quote/table markers
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>|#]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

const QUESTION_START = /^(what|why|how|when|where|who|which|is|are|can|does|do|should|will|could)\b/i;

// Split the body on h2/h3 headings, keeping heading + the chunk that follows it.
// Content-collection bodies arrive as RAW MARKDOWN (## heading), not HTML —
// handle both so the component works regardless of what the caller passes.
type Section = { heading: string; after: string };
const sections: Section[] = [];
if (/<h[23][^>]*>/i.test(body)) {
  for (const part of body.split(/(?=<h[23][^>]*>)/i)) {
    const hm = part.match(/<h[23][^>]*>([\s\S]*?)<\/h[23]>/i);
    if (!hm) continue;
    sections.push({ heading: hm[1], after: part.slice(hm.index! + hm[0].length) });
  }
} else {
  for (const part of body.split(/(?=^#{2,3}[ \t])/m)) {
    const hm = part.match(/^#{2,3}[ \t]+(.+)/);
    if (!hm) continue;
    sections.push({ heading: hm[1], after: part.slice(hm[0].length) });
  }
}
const faqs: { q: string; a: string }[] = [];
for (const { heading, after } of sections) {
  const q = stripTags(heading);
  if (!q || (!q.endsWith('?') && !QUESTION_START.test(q))) continue;
  let a = stripTags(after);
  if (a.length < 40) continue;
  // First 1–2 sentences, capped so the schema stays tight and quotable.
  const cut = a.slice(0, 300);
  const stop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('? '), cut.lastIndexOf('! '));
  a = stop > 60 ? cut.slice(0, stop + 1).trim() : cut.replace(/\s+\S*$/, '').trim();
  faqs.push({ q: q.replace(/^["']|["']$/g, ''), a });
  if (faqs.length >= 5) break;
}

const schema = faqs.length >= 2 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
{schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
