---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import MonetagAds from './MonetagAds.astro'; // Now loads Adsterra global units (Popunder + Social Bar)
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	/** "website" for index/listing pages, "article" for blog posts. */
	ogType?: string;
	/** When true, tell search/AI engines not to index this page (still followed). */
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = FallbackImage, ogType = 'website', noindex = false } = Astro.props;

// Resolve a fully-qualified social-share image from either an imported asset
// (ImageMetadata) or a string path/URL (per-post hero). Falls back to the
// bundled placeholder. This is what makes link previews show the real hero.
const rawImage = typeof image === 'string' ? image : image.src;
const ogImage = rawImage.startsWith('http')
	? rawImage
	: new URL(rawImage, Astro.url).toString();

// Append the brand to every page title (except the homepage, which already is the
// brand) so search results carry recognizable, consistent branding.
const fullTitle =
	title === SITE_TITLE || title.includes(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`;
---

