---
// Astro Signal AI Growth Advisor: a conversion-focused assistant for AI, automation,
// AEO/GEO and implementation opportunities. It stays useful first, then asks for
// an email only when the visitor requests a personalized plan.
---
<div id="ts-chat" class="ts-chat">
  <button id="ts-chat-toggle" class="ts-chat-toggle" aria-label="Open AI Growth Advisor" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  </button>
  <section id="ts-chat-panel" class="ts-chat-panel" hidden aria-label="Chat with the AI Growth Advisor">
    <header class="ts-chat-header"><div><strong>AI Growth Advisor</strong><small>Find your highest-value next move</small></div><button id="ts-chat-clear" class="ts-chat-clear" type="button">Clear</button></header>
    <div id="ts-chat-log" class="ts-chat-log" aria-live="polite"></div>
    <div id="ts-chat-prompts" class="ts-chat-prompts" aria-label="Suggested questions">
      <button type="button" data-prompt="I run a small business. Find my best AI automation opportunity.">Find my best automation</button>
      <button type="button" data-prompt="I want to get more visibility in ChatGPT and AI search.">Improve my AI visibility</button>
      <button type="button" data-prompt="I want to build an AI-powered revenue system. Where should I start?">Build a revenue system</button>
    </div>
    <form id="ts-chat-form" class="ts-chat-form"><input id="ts-chat-input" type="text" placeholder="Tell me what you want to improve…" autocomplete="off" maxlength="1000" required /><button type="submit">Send</button></form>
  </section>
</div>
<script>
  const HISTORY_KEY = 'ts-chat-history-v2'; const SESSION_KEY = 'ts-chat-session'; const MAX_HISTORY = 16;
  type Msg = { role: 'user' | 'assistant'; content: string };
  const toggle = document.getElementById('ts-chat-toggle') as HTMLButtonElement; const panel = document.getElementById('ts-chat-panel') as HTMLElement; const log = document.getElementById('ts-chat-log') as HTMLElement; const form = document.getElementById('ts-chat-form') as HTMLFormElement; const input = document.getElementById('ts-chat-input') as HTMLInputElement; const clear = document.getElementById('ts-chat-clear') as HTMLButtonElement; const prompts = document.getElementById('ts-chat-prompts') as HTMLElement;
  let history: Msg[] = []; try { history = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); } catch {}
  let sessionId = localStorage.getItem(SESSION_KEY); if (!sessionId) { sessionId = crypto.randomUUID(); localStorage.setItem(SESSION_KEY, sessionId); }
  let busy = false; let replyCount = 0;
  function track(event: string, data: Record<string, unknown> = {}) { try { navigator.sendBeacon('/api/chat-lead', new Blob([JSON.stringify({ action: 'event', event, sessionId, path: location.pathname, ...data })], { type: 'application/json' })); } catch {} }
  function bubble(role: Msg['role'], text: string): HTMLElement { const el = document.createElement('div'); el.className = `ts-chat-msg ts-chat-${role}`; el.textContent = text; log.appendChild(el); log.scrollTop = log.scrollHeight; return el; }
  function save() { history = history.slice(-MAX_HISTORY); localStorage.setItem(HISTORY_KEY, JSON.stringify(history)); }
  history.forEach((m) => bubble(m.role, m.content));
  if (!history.length) { bubble('assistant', "Hi — I’m your AI Growth Advisor. I can help you find an automation opportunity, improve your visibility in AI search, or design a practical AI revenue system."); track('advisor_started'); }
  function openAdvisor() { panel.hidden = false; toggle.setAttribute('aria-expanded', 'true'); input.focus(); track('advisor_opened'); }
  toggle.addEventListener('click', () => { if (panel.hidden) openAdvisor(); else { panel.hidden = true; toggle.setAttribute('aria-expanded', 'false'); } });
  document.addEventListener('astro:open-growth-advisor', openAdvisor);
  clear.addEventListener('click', () => { history = []; save(); log.replaceChildren(); bubble('assistant', 'Let’s start fresh. What result would make the biggest difference to your business right now?'); replyCount = 0; });
  prompts.querySelectorAll('button').forEach((button) => button.addEventListener('click', () => { input.value = button.getAttribute('data-prompt') || ''; form.requestSubmit(); }));
  async function streamReply(target: HTMLElement): Promise<string> {
    const res = await fetch('/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history }) }); if (!res.ok || !res.body) throw new Error(`Chat failed (${res.status})`);
    const reader = res.body.getReader(); const decoder = new TextDecoder(); let buffer = ''; let text = '';
    while (true) { const { done, value } = await reader.read(); if (done) break; buffer += decoder.decode(value, { stream: true }); const lines = buffer.split('\n'); buffer = lines.pop() || ''; for (const line of lines) { if (!line.startsWith('data:')) continue; const data = line.slice(5).trim(); if (!data || data === '[DONE]') continue; try { const chunk = JSON.parse(data).response; if (typeof chunk === 'string') { text += chunk; target.textContent = text; log.scrollTop = log.scrollHeight; } } catch {} } }
    return text.trim();
  }
  function showPlanCapture() {
    if (document.getElementById('ts-chat-capture')) return;
    const card = document.createElement('form'); card.id = 'ts-chat-capture'; card.className = 'ts-chat-capture'; card.innerHTML = '<strong>Get your personalized 30-day plan</strong><span>I’ll send the recommendations, tools and next steps to your inbox.</span><div><input type="email" name="email" placeholder="you@company.com" required aria-label="Email address"/><button type="submit">Send my plan</button></div><small>One useful email. No spam. Unsubscribe anytime.</small>';
    card.addEventListener('submit', async (event) => { event.preventDefault(); const email = String(new FormData(card).get('email') || '').trim(); const button = card.querySelector('button') as HTMLButtonElement; button.disabled = true; button.textContent = 'Sending…'; try { const res = await fetch('/api/chat-lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'lead', email, sessionId, path: location.pathname, messages: history, intent: history.map((m) => m.content).join(' ').slice(0, 1500) }) }); if (!res.ok) throw new Error('lead failed'); card.innerHTML = '<strong>You’re on the list.</strong><span>Your plan is being prepared. If your need is urgent, ask me about a done-for-you implementation.</span>'; track('lead_captured'); } catch { button.disabled = false; button.textContent = 'Try again'; } });
    log.appendChild(card); log.scrollTop = log.scrollHeight; track('plan_offer_shown');
  }
  form.addEventListener('submit', async (event) => { event.preventDefault(); const text = input.value.trim(); if (!text || busy) return; busy = true; input.value = ''; prompts.style.display = 'none'; bubble('user', text); history.push({ role: 'user', content: text }); save(); const target = bubble('assistant', 'Thinking through the highest-value path…'); try { const reply = await streamReply(target); if (!reply) throw new Error('Empty reply'); history.push({ role: 'assistant', content: reply }); save(); replyCount += 1; track('reply_received', { replyCount }); if (replyCount >= 2 || /plan|audit|send|email|build this|implementation/i.test(text + ' ' + reply)) showPlanCapture(); } catch { target.textContent = 'I hit a temporary issue. Please try again, or contact us for a human-led strategy session.'; } finally { busy = false; } });
</script>
<style is:global>
  .ts-chat { position: fixed; left: 20px; bottom: 20px; z-index: 9999; font-family: inherit; } .ts-chat-toggle { width: 58px; height: 58px; border-radius: 50%; border: none; cursor: pointer; color: #fff; background: linear-gradient(135deg, #00A67F, #0E7490); box-shadow: 0 8px 24px rgba(0,0,0,.22); display: flex; align-items: center; justify-content: center; } .ts-chat-panel { position: absolute; left: 0; bottom: 72px; width: min(390px, calc(100vw - 32px)); height: min(610px, calc(100vh - 110px)); background: #fff; border-radius: 16px; box-shadow: 0 18px 55px rgba(0,0,0,.24); display: flex; flex-direction: column; overflow: hidden; border: 1px solid #dbe4e7; } .ts-chat-panel[hidden] { display: none; } .ts-chat-header { display: flex; justify-content: space-between; align-items: center; padding: .95rem 1rem; color: #fff; background: linear-gradient(135deg, #00A67F, #0E7490); } .ts-chat-header strong, .ts-chat-header small { display: block; } .ts-chat-header small { opacity: .86; font-weight: 400; font-size: .74rem; margin-top: .15rem; } .ts-chat-clear { background: transparent; border: 1px solid rgba(255,255,255,.6); color: #fff; border-radius: 6px; padding: .25rem .6rem; cursor: pointer; font-size: .78rem; } .ts-chat-log { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: .65rem; background: #f5f8f9; } .ts-chat-msg { max-width: 88%; padding: .65rem .85rem; border-radius: 13px; font-size: .91rem; line-height: 1.48; white-space: pre-wrap; word-wrap: break-word; } .ts-chat-user { align-self: flex-end; background: #008d70; color: #fff; } .ts-chat-assistant { align-self: flex-start; background: #fff; color: #182326; border: 1px solid #e1e8ea; } .ts-chat-prompts { display: flex; gap: .4rem; padding: .65rem .75rem .2rem; overflow-x: auto; background: #f5f8f9; } .ts-chat-prompts button { white-space: nowrap; border: 1px solid #b9d9d4; background: #eafff9; color: #006f5a; border-radius: 999px; padding: .4rem .62rem; cursor: pointer; font-size: .72rem; } .ts-chat-form { display: flex; gap: .5rem; padding: .75rem; border-top: 1px solid #e1e8ea; background: #fff; } .ts-chat-form input { flex: 1; min-width: 0; padding: .62rem .75rem; border: 1px solid #cbd5d8; border-radius: 8px; font-size: .9rem; } .ts-chat-form button, .ts-chat-capture button { padding: .62rem .85rem; border: none; border-radius: 8px; background: #008d70; color: #fff; font-weight: 700; cursor: pointer; } .ts-chat-capture { align-self: stretch; display: flex; flex-direction: column; gap: .4rem; padding: .85rem; background: #edfff9; border: 1px solid #a6ded1; border-radius: 12px; color: #153c37; } .ts-chat-capture span { font-size: .82rem; line-height: 1.4; } .ts-chat-capture div { display: flex; gap: .4rem; } .ts-chat-capture input { flex: 1; min-width: 0; border: 1px solid #b8d2ce; border-radius: 7px; padding: .55rem; } .ts-chat-capture button { font-size: .76rem; padding: .55rem .65rem; } .ts-chat-capture small { color: #52716c; font-size: .68rem; } @media (max-width: 480px) { .ts-chat { left: 12px; bottom: 12px; } .ts-chat-panel { width: calc(100vw - 24px); } }
</style>
