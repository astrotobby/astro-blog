---
/**
 * Conservative first-test monetization setup.
 * Run one Monetag zone at a time; avoid stacking intrusive formats
 * from multiple networks while establishing a clean baseline.
 */
---
<script is:inline>
  (function () {
    var root = document.documentElement || document.body;
    if (!root) return;
    var s = document.createElement('script');
    s.dataset.zone = '11244264';
    s.src = 'https://nap5k.com/tag.min.js';
    s.async = true;
    root.appendChild(s);
  })();
</script>
