---
// Adsterra global ad loaders — injects Popunder and Social Bar scripts on every page.
// These are auto-display formats; Adsterra decides when to show them.
// Replaces previous Monetag vignette (zone 11242675) and in-page push (zone 11242710).
import { ADSTERRA_GLOBAL_UNITS } from '../consts';
---
{ADSTERRA_GLOBAL_UNITS.map((unit) => (
  <script is:inline define:vars={{ src: unit.src }}>
    (function () {
      var s = document.createElement('script');
      s.src = src;
      s.async = true;
      document.body.appendChild(s);
    })();
  </script>
))}
